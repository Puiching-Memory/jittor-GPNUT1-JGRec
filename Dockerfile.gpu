ARG CUDA_BASE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/nvidia/cuda:11.8.0-devel-ubuntu22.04

FROM jgrec-stage0:latest AS stage0

FROM ${CUDA_BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/usr/local/cuda/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}
ENV CUDA_HOME=/usr/local/cuda
ENV CUDA_PATH=/usr/local/cuda
ENV PYTHONUNBUFFERED=1

COPY --from=stage0 /opt/JittorGeometric-main /opt/JittorGeometric-main

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        libcudnn8=8.9.7.29-1+cuda11.8 \
        libcudnn8-dev=8.9.7.29-1+cuda11.8 \
        libomp-dev \
        ninja-build \
        python-is-python3 \
        python3 \
        python3-dev \
        python3-pip \
        python3-setuptools \
        python3-venv \
        python3-wheel \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python -m pip install --no-cache-dir \
        "einops>=0.8.0" \
        "networkx>=3.2" \
        "numpy==1.24.0" \
        "pymetis==2023.1.1" \
        "pyparsing==3.2.1" \
        "rich>=15.0.0" \
        "scikit-learn==1.6.1" \
        "scipy==1.15.1" \
        "sympy==1.13.3" \
        "tyro>=0.9.0" \
        "pytest>=8.3" \
        "pytest-cov>=6.0" \
        "ruff>=0.8.0" \
        "zensical>=0.0.43" \
    && python -m pip install --no-cache-dir "jittor==1.3.11.0" \
    && python -m pip install --no-cache-dir /opt/JittorGeometric-main

WORKDIR /workspace
